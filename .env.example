# Copia este archivo a ".env" en la raíz del proyecto y ajusta los valores.
# La app carga .env al arrancar (python-dotenv). No subas .env al repositorio.

# Ruta absoluta al ejecutable de Blender (debe ser blender.exe, NO la carpeta del menú Inicio).
# Ejemplos típicos en Windows:
#   C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
#   C:\Program Files\Blender Foundation\Blender 3.6\blender.exe
# Cómo localizarlo: clic derecho en el acceso directo de Blender → "Abrir ubicación del archivo"
# hasta llegar a la carpeta de instalación donde está blender.exe.
BLENDER_EXECUTABLE=

# Personaje en T-Pose (FBX o GLB). Ruta relativa al proyecto o absoluta.
# Prioridad: MIXAMO_BASE_CHARACTER > MIXAMO_BASE_GLB > assets/character.fbx > assets/character.glb
MIXAMO_BASE_CHARACTER=assets/character.fbx
