# Copia este archivo a ".env" en la raíz del proyecto y ajusta los valores.
# La app carga .env al arrancar (python-dotenv). No subas .env al repositorio.

# Ruta absoluta al ejecutable de Blender (debe ser blender.exe, NO la carpeta del menú Inicio).
# Ejemplos típicos en Windows:
#   C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
#   C:\Program Files\Blender Foundation\Blender 3.6\blender.exe
# Cómo localizarlo: clic derecho en el acceso directo de Blender → "Abrir ubicación del archivo"
# hasta llegar a la carpeta de instalación donde está blender.exe.
BLENDER_EXECUTABLE=

# Personaje en T-Pose (FBX o GLB). Ruta relativa al proyecto o absoluta.
# Prioridad: MIXAMO_BASE_CHARACTER > MIXAMO_BASE_GLB > assets/character.fbx > assets/character.glb
MIXAMO_BASE_CHARACTER=assets/character.fbx

# Blender: abrir ventana (sin --background) para ver la ejecución. Cierra Blender al terminar el script.
# BLENDER_GUI=1

# Blender / depuración: imprimir salida del subproceso en la consola donde corre Flask (sin capturar).
# BLENDER_LOG_OUTPUT=1

# PyVista: hybrid (mezcla torso +Z mundo, por defecto), world, world_front o body.
# PYVISTA_CAMERA_VIEW=hybrid
# PYVISTA_HYBRID_BODY_FORWARD_WEIGHT=0.7
# PYVISTA_CAM_YAW_DEG=0

# Blender retarget MP4: offset foco→cámara (más negativo en Y = más lejos). Escala opcional.
# BLENDER_CAM_OFFSET=0.0,-10.0,0.55
# BLENDER_CAM_DISTANCE_SCALE=1.2
# BLENDER_CAM_ELEV_DEG=0
# BLENDER_CAM_LENS=35
# Giro alrededor del eje de vista (0 o 180 si el modelo sale al revés).
# BLENDER_CAM_ROLL_DEG=180
# Motor: WORKBENCH (rápido, sin luces) o EEVEE (más lento).
# BLENDER_RENDER_ENGINE=WORKBENCH
# BLENDER_RENDER_SCALE_PERCENT=75
# Solo con EEVEE:
# BLENDER_WORLD_STRENGTH=0.42
# BLENDER_SUN_ENERGY=14
# BLENDER_FILL_WATTS=900
